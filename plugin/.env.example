# ─── SentX API ──────────────────────────────────────────────────────
# Generala en https://sentx.io/user/settings  (BETA — puede cambiar)
SENTX_API_KEY=your_sentx_api_key_here
# SENTX_PROJECT=  # opcional, si te asignaron un project name en SentX

# ─── Hedera operator ────────────────────────────────────────────────
# Necesario porque el Hedera Agent Kit instancia un Client al arrancar,
# aunque este plugin (read-only por ahora) no firma nada.
# Cualquier cuenta de mainnet sirve — no se gastará HBAR.
HEDERA_NETWORK=mainnet
HEDERA_ACCOUNT_ID=0.0.XXXXXXX
HEDERA_PRIVATE_KEY=302e020100300506032b657004220420...

# ─── LLM ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini  # opcional, default
