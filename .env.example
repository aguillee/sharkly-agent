# ─── SentX API ──────────────────────────────────────────────────────
# Public reporting key — generate at https://sentx.io/user/settings (BETA).
SENTX_API_KEY=your_sentx_api_key_here

# Affiliate key — REQUIRED to enable the buy_nft tool. Apply for affiliate
# access in the SentX dashboard. If omitted, Sharkly runs in read-only mode.
# SENTX_AFFILIATE_KEY=your_sentx_affiliate_key_here

# Affiliate signing wallet — REQUIRED alongside SENTX_AFFILIATE_KEY for buy_nft.
# This is the Hedera account associated with your affiliate API key (its
# private key signs SentX's wallet-auth challenge). It does NOT pay for NFTs;
# the BUYER operator (HEDERA_* below) does. Use a dedicated account here, NEVER
# your main wallet.
# HEDERA_AFFILIATE_ACCOUNT_ID=0.0.XXXXXXX
# HEDERA_AFFILIATE_PRIVATE_KEY=0x... # ECDSA recommended (SentX issues ECDSA)

# ─── LLM (Anthropic primary, Vercel Gateway fallback) ───────────────
# At least ONE of these must be set. ANTHROPIC_API_KEY wins if both exist.
ANTHROPIC_API_KEY=sk-ant-...
# AI_GATEWAY_API_KEY=vck_...     # fallback. Auto-injected as VERCEL_OIDC_TOKEN inside Vercel deploys.

# Optional model override. With Anthropic direct, use plain names.
# LLM_MODEL=claude-haiku-4-5    # default — cheap & fast
# LLM_MODEL=claude-sonnet-4-5   # higher quality
# LLM_MODEL=claude-opus-4-1     # premium

# ─── Hedera mainnet operator (REQUIRED for buy_nft) ─────────────────
# The agent uses this account to sign NFT purchases. It MUST have enough
# HBAR for the NFT price + network fees. Sharkly NEVER signs without an
# explicit user confirmation in the UI.
#
# SECURITY: use a dedicated mainnet account funded with only what you're
# willing to spend on Sharkly (suggest 30–50 HBAR for the demo). Do NOT
# use your main wallet here.
HEDERA_NETWORK=mainnet
HEDERA_ACCOUNT_ID=0.0.XXXXXXX
HEDERA_PRIVATE_KEY=...      # ECDSA (DER-encoded hex or 0x...) or ED25519
